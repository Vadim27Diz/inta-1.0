{
  "name": "ds",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens:build": "node .claude/skills/design-tokens/scripts/build-tokens.mjs tokens/tokens.json src/styles/tokens.css",
    "tokens:catalog": "node .claude/skills/design-tokens/scripts/build-tokens.mjs tokens/tokens.json src/styles/tokens.css .claude/skills/design-tokens/references/token-catalog.md",
    "tokens:check": "node .claude/skills/design-tokens/scripts/check-tokens.mjs src/components",
    "tokens:contrast": "node .claude/skills/design-tokens/scripts/check-contrast.mjs tokens/tokens.json",
    "storybook": "storybook dev -p 6006",
    "storybook:theme": "node scripts/build-manager-theme.mjs tokens/tokens.json .storybook/theme.generated.ts src/styles/tokens.css",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "visual": "node scripts/visual.mjs",
    "icons:stroke": "node scripts/icon-stroke-check.mjs",
    "figma:diff": "node scripts/figma-code-diff.mjs",
    "figma:layout": "node scripts/figma-layout-check.mjs",
    "tailwind:check": "node scripts/check-tailwind-classes.mjs",
    "verify": "npm run tokens:check && npm run tokens:contrast && npm run tailwind:check && npm run figma:diff && npm run figma:layout"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "chromatic": "^18.13.0",
    "lucide-static": "^1.57.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.2",
    "storybook-addon-pseudo-states": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
